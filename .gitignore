# Source data is downloaded, not committed: the raw 911 CSV is ~191 MB, which is
# over GitHub's 100 MB hard limit, and the Parquet cache is ~58 MB. Both are
# reproducible with `python scripts/download_data.py && python scripts/preprocess.py`.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# data/deploy/ IS committed, and deliberately: it is the ~12 MB slice the hosted
# app runs on, because a deployed container has no download step and about 1 GB
# of memory. Rebuild it with `python scripts/make_deploy_data.py`; see the path
# resolution at the top of src/config.py for how the full local dataset takes
# precedence over it.

# Generated preview page (scripts/render_charts.py)
charts_preview.html

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Agent-skill symlinks Streamlit drops into the project; they point into the
# local site-packages install and are meaningless outside this machine.
.agents/
.claude/

# Serena's local symbol cache and project config — machine-specific.
.serena/

# LaTeX build artefacts from paper/ (main.tex, slides.tex). The PDFs are
# committed; the intermediates are not.
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz
